// Semantic layer - 2025/07 Customer Satisfaction & Loyalty  (Gate G4)
//
// This file IS the Technical evidence. Rubric A scores "data modelling / DAX usage".
//
// THE CENTRAL FACT, enforced throughout: with n=120 this survey cannot detect a
// difference smaller than 1.55 points on a 10-point scale (insights.md I-4). So EVERY
// mean measure here is paired with its `n` and with `is_underpowered`, and the model
// exposes `min_detectable_difference` as a first-class measure. A mean without its
// sample size is misleading on this dataset, and the model refuses to offer one.

source: dim_location is duckdb.table('../data/curated/dim_location.parquet') extend {
  primary_key: location_key
}
source: dim_factor is duckdb.table('../data/curated/dim_factor.parquet') extend {
  primary_key: factor_key
}
source: dim_segment is duckdb.table('../data/curated/dim_segment.parquet') extend {
  primary_key: segment_key
}

source: customers is duckdb.table('../data/curated/fct_customer.parquet') extend {
  join_one: place  is dim_location with location_key
  join_one: factor is dim_factor   with factor_key
  join_one: seg    is dim_segment  with segment_key

  //--------------------------------------------------------------------------------
  // Base measures. `respondents` is never optional -- see the note above.
  //--------------------------------------------------------------------------------
  measure:
    respondents   is count()
    mean_score    is satisfaction_score.avg()
    score_sd      is stddev(satisfaction_score)
    min_score     is satisfaction_score.min()
    max_score     is satisfaction_score.max()
    mean_age      is age.avg()

    // share of the whole, so a group's size is always legible next to its mean
    share_of_base is count() / all(count()) * 100

  //--------------------------------------------------------------------------------
  // Power-aware measures. This is the month's Technical argument.
  //--------------------------------------------------------------------------------
  measure:
    // 95% CI half-width on the group mean: 1.96 * sd / sqrt(n)
    ci_halfwidth is 1.96 * stddev(satisfaction_score) / sqrt(count())

    // Smallest two-group difference detectable at 80% power with THIS group's n:
    // sqrt(2 * (1.96 + 0.8416)^2 / n) * sd
    min_detectable_difference is sqrt(2 * pow(2.8016, 2) / count()) * stddev(satisfaction_score)

    // A group this small cannot detect a 1.5-point effect; flagged, never hidden.
    underpowered_groups is count() { where: place.is_underpowered }

  dimension:
    contacted_support is support_contacted = 'Yes'
    is_repeat_buyer   is purchase_history = 'Yes'

  //--------------------------------------------------------------------------------
  // Views - one per brief requirement, each carrying n and the detectable threshold
  //--------------------------------------------------------------------------------

  // R1 / R5 - satisfaction factors. The apparent effect; shown with its group sizes.
  view: by_factor is {
    group_by: factor.satisfaction_factor
    aggregate: respondents, mean_score, ci_halfwidth, min_detectable_difference
    order_by: mean_score desc
  }

  // R4 - the headline question. Two groups, and the difference is 0.013 points.
  view: support_effect is {
    group_by: support_contacted
    aggregate: respondents, mean_score, score_sd, ci_halfwidth, min_detectable_difference
    order_by: support_contacted
  }

  // R8 - loyalty vs satisfaction. Non-monotonic, which is the answer.
  view: loyalty_effect is {
    group_by: loyalty_level
    aggregate: respondents, mean_score, ci_halfwidth
    order_by: mean_score desc
  }

  // R2 - demographic segments.
  view: by_gender is {
    group_by: gender
    aggregate: respondents, mean_score, ci_halfwidth
  }

  view: by_age_band is {
    group_by: age_band
    aggregate: respondents, mean_score, mean_age, ci_halfwidth
    order_by: age_band
  }

  view: by_group is {
    group_by: `group`
    aggregate: respondents, mean_score, ci_halfwidth
  }

  // R6 - repeat purchasers.
  view: by_purchase_history is {
    group_by: purchase_history
    aggregate: respondents, mean_score, ci_halfwidth, min_detectable_difference
  }

  // R3 / R7 - geography. Every city is underpowered; the flag rides along.
  view: by_location is {
    group_by: place.city, place.state, place.is_underpowered
    aggregate: respondents, mean_score, ci_halfwidth
    order_by: mean_score desc
  }

  view: by_state is {
    group_by: place.state
    aggregate: respondents, mean_score, ci_halfwidth
    order_by: respondents desc
  }

  // R9 - do demographics favour particular factors? Nested so cell sizes are visible.
  view: factor_by_gender is {
    group_by: gender
    aggregate: respondents
    nest: factors is {
      group_by: factor.satisfaction_factor
      aggregate: respondents, mean_score
      order_by: respondents desc
      limit: 5
    }
  }

  // The distribution itself -- I-1, the flat histogram.
  view: score_distribution is {
    group_by: satisfaction_score
    aggregate: respondents
    order_by: satisfaction_score
  }

  // Headline strip.
  view: headline is {
    aggregate:
      respondents
      mean_score
      score_sd
      min_detectable_difference
  }
}
