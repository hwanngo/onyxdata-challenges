// Semantic layer - 2025/10 Consumer Financial Complaints (CFPB)  (Gate G4)
//
// This file IS the Technical evidence. Rubric A scores "DAX usage, data modelling".
//
// TWO RULES ENFORCED THROUGHOUT:
//
//   1. TIMELINESS DIVIDES BY RESOLVED COMPLAINTS, NEVER BY ALL OF THEM. `Timely response?`
//      is null on exactly the 1,494 in-progress complaints. Dividing by everything gives
//      93.77%; the correct figure is 96.06%. The measure below filters, so a view cannot
//      get it wrong by omission -- and `in_progress` is exposed so the gap is visible.
//
//   2. THE PARTIAL MONTH IS A DIMENSION, NOT A FOOTNOTE. The extract stops on 2023-08-28.
//      Any trend view that includes it draws a rising series collapsing. `is_partial_month`
//      travels with the data and `complaints_full_months` excludes it.
//
// And the company source deliberately offers `kpi_per_1pct_share` NEXT TO `share_rank`,
// because the month's finding is that they are the same ranking inverted (rho = +0.989).

// The dimensions key on their NATURAL value. The fact carries the label, not a surrogate:
// with 9 products and 76 issues a surrogate buys nothing and costs a join nobody can read.
source: dim_product is duckdb.table('../data/curated/dim_product.parquet') extend {
  primary_key: product
}
source: dim_issue is duckdb.table('../data/curated/dim_issue.parquet') extend {
  primary_key: issue
}
source: dim_channel is duckdb.table('../data/curated/dim_channel.parquet') extend {
  primary_key: channel
}
source: dim_state is duckdb.table('../data/curated/dim_state.parquet') extend {
  primary_key: state
}

// The company dimension, carrying its own refutation.
source: companies is duckdb.table('../data/curated/dim_company.parquet') extend {
  measure:
    firms            is count()
    total_complaints is sum(complaints)
    avg_complaints   is avg(complaints)
    avg_share        is avg(market_share_pct)
    avg_kpi          is avg(kpi_per_1pct_share)
    avg_timely       is avg(timely_rate) * 100
    avg_reputation   is avg(reputation)

  // THE FINDING. Volume is flat across size; the KPI is not.
  view: kpi_by_size is {
    group_by: size_tier
    aggregate: firms, avg_share, avg_complaints, avg_kpi, avg_timely
    order_by: avg_share desc
  }

  // The ten "worst offenders" the shipped metric produces. Every one is the smallest firm.
  view: worst_offenders_by_shipped_kpi is {
    group_by: company_id, size_tier, market_share_pct, complaints, kpi_per_1pct_share
    order_by: kpi_per_1pct_share desc
    limit: 10
  }

  // The same book ranked by raw volume instead -- a completely different set of firms.
  view: worst_offenders_by_volume is {
    group_by: company_id, size_tier, market_share_pct, complaints, kpi_per_1pct_share
    order_by: complaints desc
    limit: 10
  }

  view: traits_vs_outcomes is {
    group_by: enforcement, size_tier
    aggregate: firms, avg_timely, avg_reputation, avg_complaints
    order_by: enforcement, size_tier
  }
}

source: complaints is duckdb.table('../data/curated/fct_complaint.parquet') extend {
  join_one: prod is dim_product with product
  join_one: iss  is dim_issue   with issue
  join_one: chan is dim_channel with channel
  join_one: st   is dim_state   with state

  //--------------------------------------------------------------------------------
  // Base measures. Note what `timely_rate` divides by.
  //--------------------------------------------------------------------------------
  measure:
    complaint_count is count()
    resolved        is count() { where: is_resolved }
    in_progress     is count() { where: not is_resolved }

    // RULE 1. Resolved denominator, enforced in the measure itself.
    timely_rate is avg(pick 100.0 when is_timely else 0.0) { where: is_resolved }
    // The wrong version, kept ONLY so a view can show the 2.30pp gap explicitly.
    timely_rate_wrong_denominator is avg(pick 100.0 when is_timely else 0.0)

    money_rate  is avg(pick 100.0 when got_money else 0.0)
    relief_rate is avg(pick 100.0 when got_relief else 0.0)
    avg_days    is avg(response_days)
    sub_issue_coverage is avg(pick 100.0 when sub_issue_given else 0.0)

    // RULE 2. Trend measures exclude the truncated final month.
    complaints_full_months is count() { where: not is_partial_month }

  dimension:
    response_band is pick '1  0-7 days'   when response_days < 8
                     pick '2  8-15 days'  when response_days < 16
                     pick '3 16-23 days'  when response_days < 24
                     else '4 24-30 days'

  //====================================================================================
  // Q1 - when do complaints rise or fall
  //====================================================================================
  view: volume_by_month is {
    group_by: `month`, is_partial_month
    aggregate: complaint_count, timely_rate, money_rate, avg_days
    order_by: `month`
  }

  // The same series with the truncated month removed -- the one a trend may be fitted to.
  view: volume_by_month_full_only is {
    where: not is_partial_month
    group_by: `month`
    aggregate: complaint_count, money_rate
    order_by: `month`
  }

  //====================================================================================
  // Q2 - states, with the denominator problem stated
  //====================================================================================
  view: by_state is {
    group_by: st.state, st.region
    aggregate: complaint_count, timely_rate, money_rate
    order_by: complaint_count desc
    limit: 15
  }

  view: by_region is {
    group_by: region
    aggregate: complaint_count, timely_rate, money_rate, avg_days
    order_by: complaint_count desc
  }

  //====================================================================================
  // Q3, Q4 - products and issues. The real concentration.
  //====================================================================================
  view: by_product is {
    group_by: prod.product
    aggregate: complaint_count, money_rate, relief_rate, timely_rate
    order_by: complaint_count desc
  }

  // Q4 asks which issues are "most severe". There is no severity column, so this ranks by
  // MONETARY RELIEF RATE and the UI labels it a proxy, not a measure of harm.
  view: issues_by_relief_rate is {
    group_by: iss.issue
    aggregate: complaint_count, money_rate, relief_rate, timely_rate
    having: complaint_count > 200
    order_by: money_rate desc
    limit: 15
  }

  view: by_sub_product is {
    group_by: prod.product, sub_product
    aggregate: complaint_count, money_rate
    order_by: complaint_count desc
    limit: 15
  }

  //====================================================================================
  // Q5, Q8 - speed and channel. Both are flat.
  //====================================================================================
  view: response_time_distribution is {
    group_by: response_band
    aggregate: complaint_count, timely_rate, money_rate
    order_by: response_band
  }

  view: by_channel is {
    group_by: chan.channel
    aggregate: complaint_count, avg_days, timely_rate, money_rate
    order_by: complaint_count desc
  }

  //====================================================================================
  // The denominator, shown rather than asserted
  //====================================================================================
  view: timeliness_denominator is {
    aggregate: complaint_count, resolved, in_progress,
               timely_rate, timely_rate_wrong_denominator
  }

  view: by_outcome is {
    group_by: outcome
    aggregate: complaint_count, avg_days, sub_issue_coverage
    order_by: complaint_count desc
  }
}
