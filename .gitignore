[0-9][0-9][0-9][0-9]/[0-9][0-9]/*/
![0-9][0-9][0-9][0-9]/[0-9][0-9]/analysis/
![0-9][0-9][0-9][0-9]/[0-9][0-9]/model/
![0-9][0-9][0-9][0-9]/[0-9][0-9]/design/
![0-9][0-9][0-9][0-9]/[0-9][0-9]/app/
![0-9][0-9][0-9][0-9]/[0-9][0-9]/data/
![0-9][0-9][0-9][0-9]/[0-9][0-9]/exports/
*.zip

