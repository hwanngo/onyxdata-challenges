// Semantic layer - 2026/02 Pharmacy Sales & Profitability  (Gate G4)
//
// This file IS the Technical evidence. Rubric A scores "DAX usage, data modelling" - we have
// no DAX, so the model must be legible and substantial in its own right.
//
// FOUR RULES, each one an error this dataset invites:
//
//   1. THE MARGIN RATE IS SUM(margin)/SUM(revenue). NEVER avg() OF A ROW RATE.
//      There is deliberately no row-level margin_pct column in the fact table. Averaging a
//      rate across 120 stores whose row counts span 16 to 1,200 is the denominator error
//      2025/12 shipped twice, and here it would corrupt the month's central claim.
//
//   2. SAME-STORE IS A GROUPING, NOT A FILTER SOMEONE REMEMBERS.
//      `revenue` and `revenue_same_store` sit side by side. Total revenue rose 4.43% in 2025;
//      same-store rose 0.07% (p=0.72). 98.5% of the "growth" is eleven new shops, so any view
//      that trends revenue without the cohort split is reporting the property portfolio.
//
//   3. PRE-LAUNCH ROWS ARE FLAGGED, NEVER DROPPED - AND NEVER SILENTLY INCLUDED.
//      6,221 rows (10.01%) sell a product before its LaunchDate: 47 of 47 in-window products,
//      zero exceptions. It changes no aggregate ranking, so `revenue` includes them and says
//      so. Anything lifecycle-shaped uses `revenue_launched` and takes the smaller number.
//
//   4. BRAND IS NOT A DIMENSION. All 32 brands sit inside exactly one category, so grouping
//      by brand and grouping by category are the same query. `brand_within_category` exists
//      as a nested label; there is no bare `brand` to group by as independent evidence.

source: dim_date is duckdb.table('../data/curated/dim_date.parquet') extend {
  primary_key: date_key
  dimension:
    // Named for what it is. The weekday effect is the ONLY time signal in 731 days
    // (eta2=0.384) and it is measured on transaction COUNT, not size - a trading calendar.
    // The seasonality the brief asks for does not exist: KW p=0.21.
    trading_day is pick 'weekend' when is_weekend else 'weekday'
}

source: dim_pharmacy is duckdb.table('../data/curated/dim_pharmacy.parquet') extend {
  primary_key: pharmacy_key
  dimension:
    // Rule 2 made available everywhere.
    is_same_store is cohort = 'established'
    // Geography is THREE levels, not the four the README advertises: city is 1:1 with
    // region (38/38/38). `city` is a display label and is not offered as a drill step.
    geo_path is concat(country, ' / ', region)
}

source: dim_product is duckdb.table('../data/curated/dim_product.parquet') extend {
  primary_key: product_key
  measure:
    list_margin_pct is (sum(list_price_eur) - sum(standard_cost_eur))
                       / sum(list_price_eur) * 100.0
}

// The thesis as a table. One row per cut the brief asks about, carrying the measured
// margin-rate spread and the spread chance alone produces for that cut's own group sizes.
source: dim_cut is duckdb.table('../data/curated/dim_cut.parquet') extend {
  measure:
    cuts is count()
    flat_cuts is count() { where: not exceeds_chance }
  view: the_thesis is {
    select: cut_label, cut_family, k_groups, spread_pp, chance_spread_p95_pp, exceeds_chance
    order_by: spread_pp
  }
}

source: sales is duckdb.table('../data/curated/fct_sales.parquet') extend {
  join_one: dim_date  on date_key     = dim_date.date_key
  join_one: dim_pharmacy on pharmacy_key = dim_pharmacy.pharmacy_key
  join_one: dim_product  on product_key  = dim_product.product_key

  measure:
    // --- volume -------------------------------------------------------------------
    lines is count()
    units is sum(units_sold)
    stores is count(pharmacy_key)
    products is count(product_key)

    // --- money. Rule 1: ratio of sums, always. ------------------------------------
    revenue is sum(revenue_eur)
    cost is sum(cost_eur)
    margin is sum(margin_eur)
    margin_pct is sum(margin_eur) / sum(revenue_eur) * 100.0

    // Rule 2 - the comparison that makes the growth number honest.
    revenue_same_store is sum(revenue_eur) { where: dim_pharmacy.is_same_store }
    revenue_new_store is sum(revenue_eur) { where: not dim_pharmacy.is_same_store }

    // Rule 3 - the lifecycle-safe denominator.
    revenue_launched is sum(revenue_eur) { where: not is_prelaunch }
    revenue_prelaunch is sum(revenue_eur) { where: is_prelaunch }
    prelaunch_share is sum(revenue_eur) { where: is_prelaunch }
                       / sum(revenue_eur) * 100.0
    prelaunch_lines is count() { where: is_prelaunch }

    // --- the lever ----------------------------------------------------------------
    promo_lines is count() { where: is_promo }
    promo_share is count() { where: is_promo } / count() * 100.0
    margin_pct_promo is sum(margin_eur) { where: is_promo }
                        / sum(revenue_eur) { where: is_promo } * 100.0
    margin_pct_non_promo is sum(margin_eur) { where: not is_promo }
                            / sum(revenue_eur) { where: not is_promo } * 100.0
    // The gap, and what it costs: promo revenue valued at the non-promo rate, minus what
    // it actually earned. EUR 82,709 across the book - 3.42% of total margin.
    promo_margin_gap_pp is
      sum(margin_eur) { where: not is_promo } / sum(revenue_eur) { where: not is_promo } * 100.0
      - sum(margin_eur) { where: is_promo } / sum(revenue_eur) { where: is_promo } * 100.0
    promo_margin_forgone is
      sum(revenue_eur) { where: is_promo }
        * (sum(margin_eur) { where: not is_promo } / sum(revenue_eur) { where: not is_promo })
      - sum(margin_eur) { where: is_promo }
    // The null that matters, with its own units on both sides.
    units_per_line_promo is sum(units_sold) { where: is_promo }
                            / count() { where: is_promo }
    units_per_line_non_promo is sum(units_sold) { where: not is_promo }
                                / count() { where: not is_promo }

    // --- exposure-aware, because eleven stores did not trade the whole window -------
    revenue_per_store_day is sum(revenue_eur) / dim_pharmacy.exposure_days.sum()

  dimension:
    promo_label is pick 'Promoted' when is_promo else 'Not promoted'
    launch_label is pick 'Before launch date' when is_prelaunch else 'After launch'

  // ================================================================================
  // THE THESIS: profitability does not vary by where; volume does.
  // ================================================================================

  // Rule 1 applied across every cut the brief asks about. Every geographic and structural
  // row lands on 28; only category and promotion move.
  view: margin_by_country is {
    group_by: dim_pharmacy.country
    aggregate: revenue, margin, margin_pct, lines, stores
    order_by: revenue desc
  }

  view: margin_by_region is {
    group_by: dim_pharmacy.country, dim_pharmacy.region
    aggregate: revenue, margin_pct, stores
    order_by: revenue desc
  }

  view: margin_by_pharmacy_type is {
    group_by: dim_pharmacy.pharmacy_type
    aggregate: stores, lines, revenue, margin_pct, revenue_per_store_day
    order_by: revenue desc
  }

  view: margin_by_size_band is {
    group_by: dim_pharmacy.store_size_band
    aggregate: stores, revenue, margin_pct
    order_by: revenue desc
  }

  // ...and the two that do move it. Category spans 11.66pp, promotion 9.08pp.
  view: margin_by_category is {
    group_by: dim_product.category
    aggregate: lines, units, revenue, margin, margin_pct
    order_by: margin_pct desc
  }

  // Rule 4: nested label, so this cannot be read as evidence independent of category.
  view: margin_by_brand_within_category is {
    group_by: dim_product.category, dim_product.brand_within_category
    aggregate: revenue, margin_pct
    order_by: revenue desc
  }

  // ================================================================================
  // Rule 2 - the growth number, decomposed
  // ================================================================================

  view: growth_by_cohort is {
    group_by: dim_date.`year`
    aggregate: revenue, revenue_same_store, revenue_new_store, lines
    order_by: `year`
  }

  view: revenue_by_month is {
    group_by: dim_date.year_month
    aggregate: revenue, revenue_same_store, margin_pct, lines
    order_by: year_month
  }

  // Period-over-period on the honest series: same-store only.
  view: same_store_yoy is {
    group_by: dim_date.`year`
    aggregate: revenue_same_store, margin_pct
    order_by: `year`
  }

  // ================================================================================
  // The only time structure that exists
  // ================================================================================

  view: trading_week is {
    group_by: dim_date.day_of_week, dim_date.day_name, dim_date.trading_day
    aggregate: lines, revenue, units, margin_pct
    order_by: day_of_week
  }

  // The control for the claim above: the weekday effect is in COUNT, not in size.
  view: units_per_line_by_trading_day is {
    group_by: dim_date.trading_day
    aggregate: lines, units, margin_pct
  }

  // ================================================================================
  // The lever
  // ================================================================================

  view: promo_overall is {
    aggregate:
      promo_lines, promo_share, margin_pct_promo, margin_pct_non_promo,
      promo_margin_gap_pp, promo_margin_forgone,
      units_per_line_promo, units_per_line_non_promo
  }

  // Two-way interaction: does promotion work in ANY category? The margin gap is uniform
  // (8.36-9.18pp) and the unit gap is zero everywhere.
  view: promo_by_category is {
    group_by: dim_product.category
    aggregate:
      promo_lines, margin_pct_promo, margin_pct_non_promo, promo_margin_gap_pp,
      units_per_line_promo, units_per_line_non_promo, promo_margin_forgone
    order_by: promo_margin_forgone desc
  }

  // ================================================================================
  // Rule 3 - the defect, quantified and bounded
  // ================================================================================

  view: prelaunch_overall is {
    aggregate: lines, prelaunch_lines, revenue, revenue_prelaunch, prelaunch_share
  }

  // Per-product damage. 24 of 47 have more than half their recorded revenue before launch.
  view: prelaunch_by_product is {
    where: is_prelaunch
    group_by: dim_product.product_key, dim_product.product_name, dim_product.category,
              dim_product.launch_date
    aggregate: prelaunch_lines, revenue_prelaunch
    order_by: revenue_prelaunch desc
  }

  // The bounding claim: rankings are identical with the flagged rows removed.
  view: category_rank_launched_only is {
    where: not is_prelaunch
    group_by: dim_product.category
    aggregate: revenue, margin_pct
    order_by: revenue desc
  }

  // ================================================================================
  // Rate vs volume - the distinction the whole month turns on
  // ================================================================================

  // Stores differ enormously in volume (chi2 ratio 58.1) and not at all in rate.
  // Exposure-adjusted, because eleven of them did not trade the full window.
  view: store_volume_vs_rate is {
    group_by: dim_pharmacy.pharmacy_key, dim_pharmacy.pharmacy_name,
              dim_pharmacy.country, dim_pharmacy.region,
              dim_pharmacy.pharmacy_type, dim_pharmacy.cohort
    aggregate: lines, revenue, margin_pct, revenue_per_store_day
    order_by: revenue desc
  }

  // Share-of-parent: each region's contribution inside its own country.
  view: region_share_of_country is {
    group_by: dim_pharmacy.country
    aggregate: revenue, margin_pct
    nest: regions is {
      group_by: dim_pharmacy.region
      aggregate: revenue, margin_pct, stores
      order_by: revenue desc
    }
  }

  // The drill path the brief asks for by name: country -> region -> pharmacy. Three levels,
  // because city cannot change the grouping.
  view: geography_drill is {
    group_by: dim_pharmacy.country
    aggregate: revenue, margin_pct, stores
    nest: by_region is {
      group_by: dim_pharmacy.region
      aggregate: revenue, margin_pct
      nest: by_pharmacy is {
        group_by: dim_pharmacy.pharmacy_name
        aggregate: revenue, margin_pct, revenue_per_store_day
        order_by: revenue desc
      }
    }
    order_by: revenue desc
  }

  // "High volume, low margin" - the premise the page asserts and the file denies
  // (Spearman rho = +0.394). Volume and rate per product, for the reader to check.
  view: product_volume_vs_margin is {
    group_by: dim_product.product_key, dim_product.product_name, dim_product.category
    aggregate: units, revenue, margin_pct
    order_by: units desc
  }
}
