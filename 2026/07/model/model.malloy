// Semantic layer - 2026/07 Global AI Adoption & Workforce Displacement Index  (Gate G4)
//
// This file IS the Technical evidence. Rubric A scores "DAX usage, data modelling"; we have no
// DAX, so the model must be legible and substantial in its own right.
//
// The organising constraint, carried down from model/build.py: **the wrong report must be
// inexpressible**. The audience is a policy coalition allocating reskilling money, and the file
// offers three ways to hand them a confident answer that is not there - a trend line through a
// step, a top-N ranking on an index that encodes nothing, and a net-jobs league table built
// from a column that is another column rescaled. None of the three is available here.

// =====================================================================================
// THE TIME SERIES - DECISION 1: both fits, always side by side
// =====================================================================================

source: quarter is duckdb.table('../data/curated/fact_quarter.parquet') extend {
  primary_key: date_id

  measure:
    quarters is count()
    rows is sum(rows)
    adoption is avg(mean_adoption)
    tool_hours is avg(mean_tool_hours)
    risk is avg(mean_risk)
    jobs_displaced is sum(jobs_displaced)
    reskilling_usd is sum(reskilling_usd)

  dimension:
    era is pick 'Generative-AI era' when generative_ai_era else 'Before'

  // There is no view here returning `mean_adoption` alone. The two fits travel with it, because
  // the whole finding is which of them describes the series: a step fits 3.61x better than a
  // line, and both within-era slopes are indistinguishable from flat (p = 0.997 and p = 0.980).
  view: the_series_and_both_fits is {
    group_by: date_id, year_quarter_label, era, mean_adoption, step_fit, linear_fit, rows
    order_by: date_id
  }

  // The comparison the page is built on, in two rows.
  view: before_and_after is {
    group_by: era
    aggregate: quarters, rows, adoption, tool_hours, risk
  }
}

// =====================================================================================
// THE ROW GRAIN
// =====================================================================================

source: observation is duckdb.table('../data/curated/fact_index.parquet') extend {
  primary_key: index_id

  measure:
    observations is count()
    countries is count(country_id)
    segments_touched is count(concat(country_id, '-', industry_id, '-', skill_category_id))

    adoption is avg(ai_adoption_rate)
    risk is avg(displacement_risk_index)
    jobs_displaced is sum(jobs_displaced_count)
    jobs_created is sum(jobs_created_count)
    reskilling_usd is sum(reskilling_investment_usd)

    // DECISION 6: the one headline a policy audience can hold without a caveat.
    reskilling_per_displaced_worker is
      sum(reskilling_investment_usd) / sum(jobs_displaced_count)

    // DECISION 4: there is deliberately NO `net_jobs` measure. jobs_created is
    // 0.4157 x jobs_displaced + 174.7 (R2 0.807) and the ratio never exceeds 1, so a net-jobs
    // total would rank countries by how many jobs they displaced, wearing another label.
    // What IS available is the residual from that fit, which is the only part not already
    // determined by the displacement count.
    creation_residual is sum(jobs_created_residual)

  dimension:
    era is pick 'Generative-AI era' when generative_ai_era else 'Before'
    confidence_band is
      pick 'low (<0.6)' when data_confidence_score < 0.6
      pick 'high (>=0.9)' when data_confidence_score >= 0.9
      else 'middle'

  view: by_era is {
    group_by: era
    aggregate: observations, adoption, risk, jobs_displaced, reskilling_usd,
               reskilling_per_displaced_worker
  }

  // Named on the challenge page as an analysis direction. Kruskal p = 0.823.
  view: developed_vs_emerging is {
    group_by: development_tier
    aggregate: observations, adoption, risk
  }

  // Named on the challenge page. MW p = 0.311 on 25 low-confidence rows.
  view: does_confidence_matter is {
    group_by: confidence_band
    aggregate: observations, adoption, risk
    order_by: confidence_band
  }

  view: by_skill is {
    group_by: skill_category_name, ai_replaceability_score
    aggregate: observations, risk, jobs_displaced, reskilling_usd
    order_by: ai_replaceability_score desc
  }
}

// =====================================================================================
// THE PANEL THAT IS NOT THERE - DECISION 2
// =====================================================================================

source: segment is duckdb.table('../data/curated/dim_segment.parquet') extend {
  measure:
    segments is count()
    observed_twice is count() { where: observations > 1 }
    total_observations is sum(observations)

  // Any attempt to trend a segment meets the number 1. That is the point of this table.
  view: how_often_is_a_segment_seen is {
    group_by: observations
    aggregate: segments
    order_by: observations desc
  }

  view: the_eight_repeats is {
    group_by: country_name, industry_name, skill_category_name, observations
    where: observations > 1
    order_by: country_name
  }
}

// =====================================================================================
// THE THESIS AS TABLES - read, never re-derived in a panel
// =====================================================================================

// DECISION 3. displacement_risk_index is documented as "a composite 0-10 score estimating a
// segment's exposure to AI-driven job displacement". This table holds every attribute in the
// file that describes exposure, and the measured correlation with each. "Is this index any
// good?" is READ, not argued.
source: risk_validation is duckdb.table('../data/curated/dim_risk_validation.parquet') extend {
  view: does_the_index_measure_risk is {
    group_by: driver, source, what_it_describes, spearman_rho, p_value, is_related
    order_by: spearman_rho desc
  }
}

// Every question the two briefs ask, with its verdict. A panel cannot answer one differently.
source: question is duckdb.table('../data/curated/dim_question.parquet') extend {
  view: what_can_this_file_answer is {
    group_by: n, asked_by, question, answer, statistic, verdict
    order_by: n
  }
}

source: defect is duckdb.table('../data/curated/dim_defect.parquet') extend {
  view: ledger is {
    group_by: n, column_name, defect, detail
    order_by: n
  }
}

source: skill is duckdb.table('../data/curated/fact_skill.parquet') extend {
  // The dimension's own replaceability score against the risk the fact table records.
  // Manual Skilled Trades: highest replaceability (79.6), 4th risk. Cognitive & Analytical:
  // lowest (20.9), 6th. Kruskal p = 0.770, eta2 = 0.007.
  view: replaceability_vs_observed_risk is {
    group_by: skill_category_name, ai_replaceability_score, mean_risk, rows
    order_by: ai_replaceability_score desc
  }
}

source: country is duckdb.table('../data/curated/fact_country.parquet') extend {
  // gdp_per_capita_usd is absent by construction (DECISION 5): ~500x too large with an
  // implausible ordering, so it is unusable even as a rank proxy. It survives in dim_defect.
  view: adoption_by_country is {
    group_by: country_name, development_tier, region, rows, mean_adoption, mean_risk
    order_by: mean_adoption desc
  }
}
