# solid-js is a peer dep of dna-kit and is satisfied by each month app.
# pnpm's strict resolution flags this across workspace boundaries; it's fine.
strict-peer-dependencies=false

# Keep pnpm's strict, non-flat node_modules. If a Vite plugin ever breaks on a
# missing transitive dep, add it to that package.json rather than reaching for
# node-linker=hoisted - hoisting hides the real problem.
